# Optional LangSmith tracing. Copy this file to .env and add a newly created key.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research

# Optional: set this for non-US LangSmith regions or self-hosted deployments.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Optional: required when the API key has access to multiple workspaces.
# LANGSMITH_WORKSPACE_ID=

# Required for the default OpenAI-backed research workflow.
OPENAI_API_KEY=

# Required when using the default Tavily search provider.
TAVILY_API_KEY=

# Maximum combined Tavily-search and think-tool calls for each research agent.
MAX_RESEARCH_TOOL_CALLS=3
